    given-names: Rob
    email: seaman@noao.edu
license: CC0-1.0
version: "1.0.0"
date-released: "2026-02-05"
repository-code: "https://github.com/rlseaman/MPC_designations"
url: "https://github.com/rlseaman/MPC_designations"
keywords:
